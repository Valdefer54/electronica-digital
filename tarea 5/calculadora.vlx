  "fileGroups": {
    "group-raspberry-pi-pico": [
      {
        "name": "main.py",
        "content": "\"\"\"Tarea 5: Raspberry Pi Pico + teclado 4x4 + LCD HD44780.\"\"\"\nfrom machine import Pin\nfrom time import sleep_ms, sleep_us, ticks_ms, ticks_diff\nfrom calculadora import Calculadora\n\n\nclass LCD:\n    def __init__(self):\n        self.rs = Pin(8, Pin.OUT, value=0)\n        self.en = Pin(9, Pin.OUT, value=0)\n        self.datos = [Pin(n, Pin.OUT, value=0) for n in (10, 11, 12, 13)]\n        sleep_ms(50)\n        for valor in (3, 3, 3, 2):\n            self.nibble(valor)\n            sleep_ms(5)\n        for comando in (0x28, 0x0C, 0x06, 0x01):\n            self.enviar(comando)\n            sleep_ms(2)\n\n    def nibble(self, valor):\n        for bit, pin in enumerate(self.datos):\n            pin.value((valor >> bit) & 1)\n        sleep_us(2)\n        self.en.on()\n        sleep_us(2)\n        self.en.off()\n        sleep_us(50)\n\n    def enviar(self, valor, texto=False):\n        self.rs.value(texto)\n        self.nibble(valor >> 4)\n        self.nibble(valor & 15)\n\n    def mostrar(self, lineas):\n        for direccion, texto in zip((0x80, 0xC0), lineas):\n            self.enviar(direccion)\n            for caracter in (texto + ' ' * 16)[:16]:\n                self.enviar(ord(caracter), True)\n\n\n# Una fila activa a la vez; las otras quedan en alta impedancia.\nfilas = [Pin(n, Pin.IN) for n in (0, 1, 2, 3)]\ncolumnas = [Pin(n, Pin.IN, Pin.PULL_UP) for n in (4, 5, 6, 7)]\nmapa = (('1', '2', '3', '+'), ('4', '5', '6', '-'),\n        ('7', '8', '9', '*'), ('.', '0', '=', '/'))\nraiz = Pin(14, Pin.IN, Pin.PULL_UP)\nborrar = Pin(15, Pin.IN, Pin.PULL_UP)\n\n\ndef leer_tecla():\n    if not borrar.value():\n        return 'CLEAR'\n    if not raiz.value():\n        return 'sqrt'\n    for indice, fila in enumerate(filas):\n        fila.init(Pin.OUT, value=0)\n        sleep_us(30)\n        pulsadas = [j for j, col in enumerate(columnas) if not col.value()]\n        fila.init(Pin.IN)\n        if pulsadas:\n            return mapa[indice][pulsadas[0]]\n    return None\n\n\ndef main():\n    lcd = LCD()\n    calculadora = Calculadora()\n    lcd.mostrar(calculadora.lineas())\n    print('Calculadora lista. A:+ B:- C:* D:/ *:decimal #:=')\n    print('Boton verde: raiz. Boton rojo: borrar. B al iniciar: negativo.')\n    candidata = None\n    estable = None\n    cambio = ticks_ms()\n    while True:\n        tecla = leer_tecla()\n        ahora = ticks_ms()\n        if tecla != candidata:\n            candidata = tecla\n            cambio = ahora\n        if ticks_diff(ahora, cambio) >= 25 and estable != candidata:\n            estable = candidata\n            if estable is not None:\n                calculadora.tecla(estable)\n                lineas = calculadora.lineas()\n                lcd.mostrar(lineas)\n                print(lineas[0], '|', lineas[1])\n        sleep_ms(5)\n\n\nmain()\n"
      },
      {
        "name": "calculadora.py",
        "content": "\"\"\"Logica de calculadora compatible con MicroPython y Python 3.\"\"\"\nimport math\n\n\ndef calcular(a, operacion, b=None):\n    if operacion == 'sqrt':\n        if a < 0:\n            raise ValueError('Raiz negativa')\n        resultado = math.sqrt(a)\n    elif operacion == '+':\n        resultado = a + b\n    elif operacion == '-':\n        resultado = a - b\n    elif operacion == '*':\n        resultado = a * b\n    elif operacion == '/':\n        if b == 0:\n            raise ValueError('Division por 0')\n        resultado = a / b\n    else:\n        raise ValueError('Operacion invalida')\n    if not math.isfinite(resultado):\n        raise ValueError('Fuera de rango')\n    return resultado\n\n\ndef formato(numero):\n    return '{:.10g}'.format(numero) if numero != 0 else '0'\n\n\nclass Calculadora:\n    def __init__(self):\n        self.limpiar()\n\n    def limpiar(self):\n        self.entrada = ''\n        self.anterior = None\n        self.operacion = None\n        self.terminado = False\n        self.error = ''\n        self.titulo = 'Calculadora'\n\n    def lineas(self):\n        if self.error:\n            return self.error, 'BORRAR: reinicia'\n        titulo = self.titulo\n        if self.operacion:\n            titulo = formato(self.anterior) + ' ' + self.operacion\n        return titulo[:16], (self.entrada or '0')[:16]\n\n    def tecla(self, tecla):\n        if tecla == 'CLEAR':\n            self.limpiar()\n            return\n        if self.error:\n            return\n        try:\n            self._tecla(tecla)\n        except (ValueError, OverflowError, ZeroDivisionError) as exc:\n            self.error = str(exc)[:16]\n\n    def _tecla(self, tecla):\n        if tecla in '0123456789.':\n            if self.terminado:\n                self.limpiar()\n            if tecla == '.' and '.' in self.entrada:\n                return\n            if len(self.entrada) >= 12:\n                return\n            if tecla == '.' and self.entrada in ('', '-'):\n                self.entrada += '0'\n            self.entrada += tecla\n            return\n        if tecla == '-' and self.entrada in ('', '-'):\n            self.entrada = '' if self.entrada == '-' else '-'\n            return\n        if tecla == 'sqrt':\n            if self.entrada in ('', '-'):\n                return\n            self.entrada = formato(calcular(float(self.entrada), 'sqrt'))\n            self.titulo = 'Raiz cuadrada'\n            self.terminado = self.operacion is None\n            return\n        if tecla not in ('+', '-', '*', '/', '='):\n            return\n        if self.entrada in ('', '-'):\n            if self.operacion and tecla != '=':\n                self.operacion = tecla\n            return\n        valor = float(self.entrada)\n        if self.operacion:\n            valor = calcular(self.anterior, self.operacion, valor)\n        if tecla == '=':\n            self.entrada = formato(valor)\n            self.anterior = None\n            self.operacion = None\n            self.terminado = True\n            self.titulo = 'Resultado'\n        else:\n            self.anterior = valor\n            self.operacion = tecla\n            self.entrada = ''\n            self.terminado = False\n"
      }
    ]
  },
